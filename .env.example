# Copy this file to `.env` (same folder as package.json) and fill in your key.
#   cp .env.example .env
#
# Get a key at https://console.anthropic.com/settings/keys
# .env is gitignored — your key will not be committed.
#
# Without this, Ramp still works: Sage falls back to the built-in 10-drill
# curriculum and static hints. With it, Sage writes your drills, reads your
# code as you type, and answers your questions.

ANTHROPIC_API_KEY=sk-ant-...

# Optional — change the port Ramp listens on (default 3000)
# PORT=3000

# Optional — which model Sage uses. Default is claude-opus-5 (best drills and
# the sharpest read on stuck code). Switch to a cheaper one to stretch credit:
#   claude-opus-5     $5 / $25 per MTok   (default)
#   claude-sonnet-5   $3 / $15
#   claude-haiku-4-5  $1 / $5             (~5x cheaper than Opus)
# RAMP_MODEL=claude-haiku-4-5
